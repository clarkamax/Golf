# ─────────────────────────────────────────────────────────────
# Enterprise Electric AI Receptionist — configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Model is fixed in code to claude-sonnet-4-6, but can be overridden here.
CLAUDE_MODEL=claude-sonnet-4-6

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The Twilio number that receives forwarded calls (E.164, e.g. +15551234567)
TWILIO_PHONE_NUMBER=+15551234567
# The business owner's cell that receives urgent SMS alerts (E.164)
OWNER_PHONE_NUMBER=+15559876543

# --- Google Sheets ---
GOOGLE_SHEET_ID=your_google_sheet_id_from_the_url
# Path to the service-account JSON key file (share the Sheet with its client_email)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Tab/range to append rows to
GOOGLE_SHEET_RANGE=Sheet1!A:I

# --- Server ---
PORT=3000
# Public base URL Twilio can reach (e.g. your ngrok https URL). Used for status callbacks.
PUBLIC_BASE_URL=https://your-subdomain.ngrok.io
# Validate incoming Twilio request signatures (recommended: true in production)
VALIDATE_TWILIO_SIGNATURE=true

# --- Conversation tuning ---
# Amazon Polly neural voice for <Say> (e.g. Polly.Joanna-Neural, Polly.Matthew-Neural)
TTS_VOICE=Polly.Joanna-Neural
# Max caller turns before we wrap up a runaway call
MAX_TURNS=20
# Consecutive silences/unclear responses before we politely end the call
MAX_REPROMPTS=2

# --- Local testing ---
# When true, Google Sheets + SMS are mocked (logged to console, not sent).
# The simulate script forces this on regardless of this value.
DRY_RUN=false
